#!/usr/bin/env bash
# pkg2local — 把 .deb / .rpm 装进 ~/.local，不需要 root，不改 pacman 数据库
#
#   pkg2local 包.deb           # 安装（解包到 ~/.local/opt，链接 bin，导入桌面图标）
#   pkg2local 包.rpm           # 同上，RPM 一样处理
#   pkg2local 包.deb --deps    # 只检查依赖缺哪些，不安装
#   pkg2local --uninstall 名   # 卸载（删 ~/.local/opt/名 及其链接）
#
# 适合：自包含的 Electron / Tauri / Go 单文件应用（绝大多数国产客户端）。
# 不适合：依赖 /usr 绝对路径、装 systemd 服务或内核模块的包 —— 那种用 distrobox。
set -uo pipefail

VERSION="2.1.0"
PROG=$(basename "$0")
PREFIX="$HOME/.local"
OPT="$PREFIX/opt"
BIN="$PREFIX/bin"
APPS="$PREFIX/share/applications"
ICONS="$PREFIX/share/icons"
# flatpak 装的包不在 $OPT 下（它有自己的仓库），记一本账供卸载与列表用
STATE="$PREFIX/state/pkg2local"

# 尊重 NO_COLOR，方便 GUI 前端调用时剥掉 ANSI
if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
  C_RED=""; C_GRN=""; C_YEL=""; C_CYN=""; C_BLD=""; C_OFF=""
else
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'; C_BLD=$'\033[1m'; C_OFF=$'\033[0m'
fi
OUTFD=1
say() { if [[ $OUTFD -eq 1 ]]; then echo "$*"; else echo "$*" >&2; fi; }
die() { printf '%s错误:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }
ok()  { if [[ $OUTFD -eq 1 ]]; then printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; else printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*" >&2; fi; }
warn(){ if [[ $OUTFD -eq 1 ]]; then printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*"; else printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; fi; }

usage() {
  cat <<'EOF'
pkg2local — 把 .deb / .rpm 装进 ~/.local，不需要 root，不改 pacman 数据库

  pkg2local 包.deb          安装（解包到 ~/.local/opt，链接 bin，导入桌面图标）
  pkg2local 包.rpm          同上
  pkg2local 包 -y           安装，不询问
  pkg2local 包 --deps       只检查依赖缺哪些，不安装
  pkg2local 包 --meta       只输出包头信息（JSON），不查依赖、不联网
  pkg2local 包 --json       输出完整依赖检查结果（JSON）
  pkg2local --uninstall 名  卸载（删 ~/.local/opt/名 及其链接）
  pkg2local --version       显示版本

适合：自包含的 Electron / Tauri / Go 单文件应用（绝大多数国产客户端）。
不适合：依赖 /usr 绝对路径、装 systemd 服务或内核模块的包 —— 那种用 distrobox。

RPM 说明：解包用 bsdtar（libarchive），读包头需要 rpm 或 python3 之一。
EOF
  exit 0
}

