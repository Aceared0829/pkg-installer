# ---------- rpm soname → Arch 包名 ----------
# rpm 的依赖写的是 soname（libacl.so.1），不是包名，所以单独一张表。
soname_pkg() {
  case "$1" in
    libgtk-3.so.0)        echo gtk3 ;;
    libgtk-4.so.1)        echo gtk4 ;;
    libwebkit2gtk-4.1.so.0) echo webkit2gtk-4.1 ;;
    libwebkit2gtk-4.0.so.37) echo webkit2gtk ;;
    libqt6core.so.6|libqt6gui.so.6|libqt6widgets.so.6|libqt6network.so.6) echo qt6-base ;;
    libqt5core.so.5|libqt5gui.so.5|libqt5widgets.so.5|libqt5network.so.5) echo qt5-base ;;
    libnss3.so)           echo nss ;;
    libnspr4.so)          echo nspr ;;
    libasound.so.2)       echo alsa-lib ;;
    libcups.so.2)         echo cups ;;
    libdrm.so.2)          echo libdrm ;;
    libgbm.so.1)          echo mesa ;;
    libxkbcommon.so.0)    echo libxkbcommon ;;
    libsecret-1.so.0)     echo libsecret ;;
    libpango-1.0.so.0)    echo pango ;;
    libcairo.so.2)        echo cairo ;;
    libatk-1.0.so.0)      echo atk ;;
    libatk-bridge-2.0.so.0) echo at-spi2-core ;;
    libgdk_pixbuf-2.0.so.0|libgdk-pixbuf-2.0.so.0) echo gdk-pixbuf2 ;;
    libglib-2.0.so.0|libgobject-2.0.so.0|libgio-2.0.so.0) echo glib2 ;;
