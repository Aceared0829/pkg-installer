# ---------- 卸载 ----------
if [[ "${1:-}" == "--uninstall" ]]; then
  name="${2:-}"; [[ -n "$name" ]] || die "用法: $PROG --uninstall <名称>"
  # flatpak 装的包不落在 $OPT 下，必须先认出来再走对应路线
  if [[ -f "$STATE/flatpaks" ]] && grep -qxF "$name" "$STATE/flatpaks" 2>/dev/null; then
    command -v flatpak >/dev/null 2>&1 || die "卸载 flatpak 包需要 flatpak"
    flatpak uninstall --user -y --noninteractive "$name" || die "flatpak 卸载失败: $name"
    grep -vxF "$name" "$STATE/flatpaks" > "$STATE/flatpaks.tmp" 2>/dev/null || true
    mv -f "$STATE/flatpaks.tmp" "$STATE/flatpaks" 2>/dev/null || true
    # 记账目录里那份 .pkg2local.json 也要清掉，否则 GUI 的「已安装」页还会列着它
    rm -rf "${OPT:?}/$name"
    ok "已卸载 $name（flatpak）"
    exit 0
  fi
  [[ -d "$OPT/$name" ]] || die "没装过: $OPT/$name"
  # 先删链接再删目录，否则 readlink -f 在目录消失后解析为空
  for l in "$BIN"/*; do
    [[ -L "$l" ]] || continue
    tgt=$(readlink "$l")
    [[ "$tgt" == "$OPT/$name/"* ]] && rm -f "$l" && echo "  移除 $l"
  done
  # 桌面条目可能和包名不同（例如 wechat-deb-test 里装的是 wechat.desktop），
  # 所以按 Exec=/Icon= 指向本包目录来判定，而不是按文件名
  for dt in "$APPS"/*.desktop; do
    [[ -f "$dt" ]] || continue
    if grep -qE "^(Exec|TryExec|Icon)=.*$OPT/$name/" "$dt" 2>/dev/null; then
      rm -f "$dt" && echo "  移除 $dt"
    fi
  done
  rm -f "$APPS/$name.desktop"
  find "$ICONS" -maxdepth 6 \( -name "$name.png" -o -name "$name.svg" -o -name "${name}_*.png" \) -print -delete 2>/dev/null
  rm -rf "$OPT/$name"
  ok "已卸载 $name"
  exit 0
fi

# ---------- 参数 ----------
DEPS_ONLY=0; ASSUME_YES=0; JSON_MODE=0; META_ONLY=0; PKGFILE=""
for a in "$@"; do
  case "$a" in
    -h|--help) usage ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    --deps)    DEPS_ONLY=1 ;;
    --json)    JSON_MODE=1; DEPS_ONLY=1 ;;
    --meta)    META_ONLY=1; JSON_MODE=1; DEPS_ONLY=1 ;;
    -y|--yes)  ASSUME_YES=1 ;;
    -*)        die "未知参数: $a" ;;
    *)         PKGFILE="$a" ;;
  esac
done
# JSON 模式下 stdout 只留最后一行 JSON，其余人话全部改走 stderr
[[ $JSON_MODE -eq 1 ]] && { OUTFD=0; }

[[ -n "$PKGFILE" ]] || usage
[[ -f "$PKGFILE" ]] || die "找不到文件: $PKGFILE"

# ---------- 认格式 ----------
detect_format() {
  local f=$1 m4 m8 sig
  m4=$(head -c 4 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
  case "$m4" in
    edabeedb) echo rpm; return ;;      # \xed\xab\xee\xdb
    '')       ;;                        # 空文件，落到扩展名判断
    7f454c46)
      # AppImage 是 ELF，靠偏移 8 处的 "AI\x02" 与普通二进制区分
      sig=$(head -c 12 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
      [[ "${sig:16:4}" == "4149" ]] && { echo appimage; return; } ;;
    666c6174)
      m8=$(head -c 8 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
      [[ "$m8" == "666c617470616b00" ]] && { echo flatpak; return; } ;;
  esac
  case "${f,,}" in
    *.deb) echo deb ;;
    *.rpm) echo rpm ;;
    *.appimage) echo appimage ;;
    *.flatpak|*.flatpakref) echo flatpak ;;
    *)     echo unknown ;;
  esac
}
FMT=$(detect_format "$PKGFILE")
[[ "$FMT" == "unknown" ]] && die "认不出这个包（支持 .deb / .rpm / .AppImage / .flatpak）: $PKGFILE"

# ---------- 读包头 ----------
# 统一产出四个变量：PKG VER ARCH DEPENDS（依赖用 \x1f 分隔，后面统一解析）
# 每种格式一个函数，主流程只按 FMT 分派。新加格式只需多写一个函数。

# deb：优先 dpkg-deb（字段最全）；没有就退回 bsdtar —— deb 就是个 ar 归档，
# 里面 control.tar.{xz,gz,zst} 用 bsdtar 也能读，所以 dpkg 不再是硬依赖。
read_meta_deb() {
  command -v dpkg-deb >/dev/null || die "缺 dpkg-deb（sudo pacman -S dpkg）"
  PKG=$(dpkg-deb -f "$PKGFILE" Package 2>/dev/null) || die "不是合法的 .deb: $PKGFILE"
  VER=$(dpkg-deb -f "$PKGFILE" Version 2>/dev/null)
  ARCH=$(dpkg-deb -f "$PKGFILE" Architecture 2>/dev/null)
  # Depends 是逗号分隔；统一成 \x1f 和 rpm 走同一条解析路径
  DEPENDS=$(dpkg-deb -f "$PKGFILE" Depends 2>/dev/null | tr -d '\n' | tr ',' '\037')
}

# 没有 dpkg-deb 时的 deb 读取：deb 就是 ar 归档，成员是 debian-binary / control.tar.* / data.tar.*。
# bsdtar 能直接按成员名取出 control，里面的字段和 dpkg-deb -f 完全一致，所以 dpkg 不再是硬依赖。
read_meta_deb_bsdtar() {
  local ctl
  command -v bsdtar >/dev/null 2>&1 || die "读 .deb 需要 dpkg-deb 或 bsdtar 之一：sudo pacman -S libarchive"
  ctl=$(bsdtar -xOf "$PKGFILE" "control.tar.*" 2>/dev/null | bsdtar -xOf - ./control 2>/dev/null)
  [[ -n "$ctl" ]] || die "不是合法的 .deb: $PKGFILE"
  PKG=$(printf '%s\n' "$ctl"     | sed -n 's/^Package: *//p'      | head -1)
  VER=$(printf '%s\n' "$ctl"     | sed -n 's/^Version: *//p'      | head -1)
  ARCH=$(printf '%s\n' "$ctl"    | sed -n 's/^Architecture: *//p' | head -1)
  DEPENDS=$(printf '%s\n' "$ctl" | sed -n 's/^Depends: *//p'      | head -1 | tr ',' '\037')
  [[ -n "$PKG" ]] || die "不是合法的 .deb（control 里没有 Package 字段）: $PKGFILE"
}

# rpm：有 rpm 命令就用它（Rich 依赖原样输出）；没有就内置 python 解析头部索引。
read_meta_rpm() {
  command -v bsdtar >/dev/null || die "缺 bsdtar（sudo pacman -S libarchive）"
  if command -v rpm >/dev/null 2>&1; then
    PKG=$(rpm -qp --qf '%{NAME}' "$PKGFILE" 2>/dev/null)
    VER=$(rpm -qp --qf '%{VERSION}-%{RELEASE}' "$PKGFILE" 2>/dev/null)
    ARCH=$(rpm -qp --qf '%{ARCH}' "$PKGFILE" 2>/dev/null)
    # 用 ;; 当分隔符：Rich 依赖 (a or b) 内部本来就有空格和逗号，不能拿它们当分隔
    DEPENDS=$(rpm -qp --qf '[%{REQUIRENAME};;]' "$PKGFILE" 2>/dev/null)
  elif command -v python3 >/dev/null 2>&1; then
    # 没装 rpm/rpm-tools 时的内置解析：直接读 RPM 头部索引，不依赖任何 rpm 工具
    read -r PKG VER ARCH DEPENDS < <(python3 - "$PKGFILE" <<'PYEOF'
import struct, sys
path = sys.argv[1]
d = open(path, 'rb').read()
if d[:4] != b'\xed\xab\xee\xdb':
    sys.exit(1)
off = 96                      # 跳过 lead
hdr = None
for i in range(2):            # [0]=签名头 [1]=主头
    if d[off:off+4] != b'\x8e\xad\xe8\x01':
        sys.exit(1)
    nidx, hsize = struct.unpack('>II', d[off+8:off+16])
    total = 16 + nidx * 16 + hsize
    if i == 1:
        hdr = (off, nidx)
    off += (total + 7) & ~7
off, nidx = hdr
tags = {}
for i in range(nidx):
    e = off + 16 + i * 16
    tag, typ, o, cnt = struct.unpack('>IIII', d[e:e+16])
    tags[tag] = (o, cnt)
do = off + 16 + nidx * 16

def one(tag, default=''):
    if tag not in tags:
        return default
    o, _ = tags[tag]
    end = d.index(b'\0', do + o)
    return d[do + o:end].decode('utf-8', 'replace')

def many(tag):
    if tag not in tags:
        return []
    o, cnt = tags[tag]
    out, p = [], do + o
    for _ in range(cnt):
        end = d.index(b'\0', p)
        out.append(d[p:end].decode('utf-8', 'replace'))
        p = end + 1
    return out

name = one(1000)
ver = one(1001) + '-' + one(1002)
arch = one(1022)
reqs = [r for r in many(1049) if not r.startswith(('rpmlib(', 'rtld('))]
print(name, ver, arch, '\x1f'.join(reqs))
PYEOF
)
    [[ -n "${PKG:-}" ]] || die "读不了这个 RPM 的包头（装 rpm-tools 或 python3 之一）: $PKGFILE"
  else
    die "读 RPM 包头需要 rpm-tools 或 python3 之一：sudo pacman -S rpm-tools"
  fi
  [[ -n "${PKG:-}" ]] || die "不是合法的 .rpm: $PKGFILE"
  # rpm 的依赖分隔符：rpm 命令走 ;;，内置解析器走 \x1f，统一成 \x1f
  DEPENDS=$(printf '%s' "${DEPENDS:-}" | sed 's/;;/\x1f/g')
}

# AppImage：ELF 头 + 内嵌 squashfs，自带 runtime。
# 元数据直接从自带的 .desktop 读，不需要完整解包 —— --appimage-extract 支持 pattern，
# 只解出命中的那一个文件（实测 4ms，完整解包要 1G 磁盘）。
# 注意：一次只能传一个 pattern，传两个就 exit=1。
read_meta_appimage() {
  local d dt m1 m2
  [[ -x "$PKGFILE" ]] || die "这个 AppImage 没有执行权限，先 chmod +x 再试: $PKGFILE"
  d=$(mktemp -d) || die "建不了临时目录"
  ( cd "$d" && "$PKGFILE" --appimage-extract '*.desktop' ) >/dev/null 2>&1
  dt=$(find "$d/squashfs-root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -1)
  [[ -n "$dt" ]] || { rm -rf "$d"; die "这个 AppImage 里没有 .desktop，认不出是什么应用: $PKGFILE"; }
  # 包名用 desktop 文件名，比 Name= 更适合当目录名/命令名
  PKG=$(basename "$dt" .desktop | tr 'A-Z' 'a-z')
  VER=$(sed -n 's/^X-AppImage-Version=//p' "$dt" | head -1)
  [[ -n "$VER" ]] || VER="AppImage"
  # 架构从 ELF 头 e_machine（偏移 18，小端 2 字节）读，别靠猜文件名
  m1=$(dd if="$PKGFILE" bs=1 skip=18 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')
  m2=$(dd if="$PKGFILE" bs=1 skip=19 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')
  case "$(( ${m1:-0} + ${m2:-0} * 256 ))" in
    62)  ARCH=amd64 ;;      # 0x3e x86-64
    183) ARCH=arm64 ;;      # 0xb7 aarch64
    3)   ARCH=i386 ;;       # 0x03
    40)  ARCH=armhf ;;      # 0x28
    *)   ARCH="" ;;
  esac
  rm -rf "$d"
  # AppImage 自带全部依赖，没有可声明的包级依赖可查
  DEPENDS=""
}

# flatpak bundle：头部是"名字-值"序列（flatpak\0 / "ref" / ref 串 / "metadata" / metadata 文本 / …），
# 偏移 0x10 起能直接读到 app/<id>/<arch>/<branch> 和 [Application] 段，纯文本，不必调 flatpak。
read_meta_flatpak() {
  local d ref rt
  command -v flatpak >/dev/null 2>&1 || die "装 .flatpak 需要 flatpak：sudo pacman -S flatpak"
  d=$(mktemp) || die "建不了临时文件"
  head -c 262144 "$PKGFILE" > "$d" 2>/dev/null
  ref=$(tr '\000' '\n' < "$d" | grep -m1 -E '^(app|runtime)/[A-Za-z0-9._-]+/[A-Za-z0-9_]+/[A-Za-z0-9._-]+$')
  [[ -n "$ref" ]] || { rm -f "$d"; die "读不出这个 .flatpak 的 ref，可能不是 flatpak 单文件包: $PKGFILE"; }
  PKG=$(printf '%s' "$ref" | cut -d/ -f2)          # 应用 ID，例如 org.gnome.FileRoller
  ARCH=$(printf '%s' "$ref" | cut -d/ -f3)         # x86_64
  VER=$(printf '%s' "$ref" | cut -d/ -f4)          # 分支名，flatpak 包本身不带版本号
  rt=$(tr '\000' '\n' < "$d" | grep -m1 '^runtime=' | cut -d= -f2-)
  rm -f "$d"
  # flatpak 的"依赖"就是它的 runtime，交给 flatpak 自己拉，这里只展示
  DEPENDS="${rt:-}"
}

# 按格式分派：新加一种格式，只多写一个 read_meta_<格式> 函数 + 这里一行
case "$FMT" in
  deb)
    if command -v dpkg-deb >/dev/null 2>&1; then read_meta_deb; else read_meta_deb_bsdtar; fi ;;
  rpm)       read_meta_rpm ;;
  appimage)  read_meta_appimage ;;
  flatpak)   read_meta_flatpak ;;
  *)         die "不认识这个格式: $FMT" ;;
esac

# 包名统一小写后再当目录名/命令名用。
# Debian 规范要求包名只含小写，dpkg-deb -f Package 会自动转小写；
# 但走 bsdtar 回退时读到的是 control 原文（有些厂商写成 Obsidian-1.9），
# 不归一化的话同一个包在两条路径下会装到不同目录，等于重复安装。
# flatpak 例外：应用 ID 的大小写是它的一部分（org.gnome.FileRoller）。
if [[ "$FMT" != "flatpak" ]]; then
  PKG=$(printf '%s' "$PKG" | tr 'A-Z' 'a-z')
fi

# 展示用的依赖串：内部 \x1f 分隔符换成逗号，Rich 依赖组 (a,or,b) 压成 "a 或 b"
DEPS_SHOW=""
if [[ -n "$DEPENDS" ]]; then
  # 末尾必须补换行：while read 在最后一段没有换行符时会读失败退出，
  # 最后一个依赖会被静默吞掉（Obsidian 声明 5 个只显示 4 个就是这个原因）。
  DEPS_SHOW=$(printf '%s\n' "$DEPENDS" | tr '\037' '\n' | while IFS= read -r seg; do
    if [[ "$seg" == "("* ]]; then
      inner="${seg#(}"; inner="${inner%)}"
      printf '('; printf '%s' "$inner" | sed 's/,or,/ 或 /g'; printf ')'
    else
      printf '%s' "$seg"
    fi
    printf '\n'
  done | paste -sd',' -)
fi

say "$(printf '%s%s%s 版本 %s  架构 %s  [%s]' "$C_BLD" "$PKG" "$C_OFF" "$VER" "$ARCH" "$FMT")"
[[ -n "$DEPS_SHOW" ]] && say "声明依赖: $DEPS_SHOW"

# ---------- 1. 先查 Arch 有没有现成的 ----------
ALT_HIT=""
if [[ $META_ONLY -eq 0 ]]; then
  say "--- 查 Arch 生态是否有对应包 ---"
  lower=$(echo "$PKG" | tr 'A-Z' 'a-z')
  # paru 的 AUR 搜索不支持 ^$ 锚点，只能取回名字段做精确比对
  find_repo() {   # $1=candidate -> 打印 "仓库/包名" 或空
    local c=$1 line n
    while IFS= read -r line; do
      n=${line%% *}; n=${n#*/}
      [[ "$n" == "$c" ]] && { echo "${line%% *}"; return; }
    done < <(pacman -Ss "$c" 2>/dev/null)
  }
  find_aur() {
    local c=$1 line n
    while IFS= read -r line; do
      [[ "$line" == aur/* ]] || continue
      n=${line%% *}; n=${n#aur/}
      [[ "$n" == "$c" ]] && { echo "aur/$n"; return; }
    done < <(timeout 15 paru -Ss "$c" 2>/dev/null)
  }
  # 候选名：原名 / 小写 / 再剥一层渠道后缀。
  # 厂商 rpm 常用 google-chrome-stable、microsoft-edge-beta 这类带渠道后缀的包名，
  # 而 AUR/仓库里的包名往往没有后缀——不剥就永远匹配不上。
  cands=("$PKG" "$lower")
  for base in "$PKG" "$lower"; do
    # 只剥发行渠道后缀。不剥 -desktop：slack-desktop、chrome-remote-desktop 这些
    # 本身就是正式包名，剥掉会撞上不相干的同名包。
    for suf in -bin -stable -beta -dev -unstable -canary -alpha -nightly; do
      [[ "$base" == *"$suf" ]] && cands+=("${base%"$suf"}")
    done
  done
  mapfile -t cands < <(printf '%s\n' "${cands[@]}" | awk 'NF && !seen[$0]++')
  for cand in "${cands[@]}"; do
    hit=$(find_repo "$cand")
    if [[ -n "$hit" ]]; then
      ALT_HIT="$hit"
      ok "仓库已有: $hit  —— 建议直接 paru -S ${hit#*/}，别折腾这个包"
      [[ $DEPS_ONLY -eq 0 && $ASSUME_YES -eq 0 ]] && { echo "仍要继续装？按 Ctrl-C 退出，或回车继续。"; read -r _; }
      break
    fi
    if command -v paru >/dev/null 2>&1; then
      hit=$(find_aur "$cand")
      if [[ -n "$hit" ]]; then
        ALT_HIT="$hit"
        ok "AUR 已有: $hit  —— 建议直接 paru -S ${hit#*/}，别折腾这个包"
        [[ $DEPS_ONLY -eq 0 && $ASSUME_YES -eq 0 ]] && { echo "仍要继续装？按 Ctrl-C 退出，或回车继续。"; read -r _; }
        break
      fi
    fi
  done
fi


# rpm 里还有一类"能力名"依赖：ca-certificates、wget、xdg-utils、liberation-fonts……
# 它们不是 soname 也不是文件，名字还常常和 Arch 包名不一致（liberation-fonts ↔ ttf-liberation）
cap_pkg() {
  case "$1" in
    ca-certificates)             echo ca-certificates ;;
    ca-certificates-mono)        echo ca-certificates-mono ;;
    wget)                        echo wget ;;
    curl)                        echo curl ;;
    xdg-utils)                   echo xdg-utils ;;
    liberation-fonts)            echo ttf-liberation ;;
    dejavu-fonts)                echo ttf-dejavu ;;
    fontconfig)                  echo fontconfig ;;
    coreutils)                   echo coreutils ;;
    bash)                        echo bash ;;
    sh|/bin/sh)                  echo bash ;;
    python3)                     echo python ;;
    perl)                        echo perl ;;
    zlib)                        echo zlib ;;
    systemd)                     echo systemd ;;
    glibc)                       echo glibc ;;
    *) echo "" ;;
  esac
}

# ldconfig 从桌面/容器启动时常常不在 PATH 里（/usr/sbin 不在默认 PATH），
# 找不到它会导致每个 soname 都被误判成"未知"——所以先定位并缓存一份输出
LDCONFIG=""
for c in ldconfig /usr/sbin/ldconfig /sbin/ldconfig /usr/bin/ldconfig; do
  if command -v "$c" >/dev/null 2>&1 || [[ -x "$c" ]]; then LDCONFIG="$c"; break; fi
done
LDC_CACHE=""
[[ -n "$LDCONFIG" ]] && LDC_CACHE=$("$LDCONFIG" -p 2>/dev/null || true)

# 把 ldconfig -p 的名字列进关联数组，供 classify_dep 做 O(1) 查表。
# 不用 `printf | grep -q`：缓存几万行，grep 提前退出会让 printf 吃 SIGPIPE，
# 每查一个 soname 就刷一屏"断开的管道"。
declare -A LDC_NAMES=()
while IFS= read -r line; do
  # 只认 "\tlibfoo.so.1 (libc6,x86-64) => /path" 这种真条目；
  # ldconfig 在非英文 locale 下会先打一行「在缓存 … 中找到 N 个库」，别把它当库名。
  [[ "$line" == [[:space:]]* ]] || continue
  _n="${line#"${line%%[![:space:]]*}"}"
  _n="${_n%% *}"
  [[ "$_n" == *.so* ]] && LDC_NAMES["$_n"]=1
done <<< "$LDC_CACHE"

# 手工解 RPM payload：切出 payload → 解压 → 按 cpio newc 逐条恢复。
# 用于 bsdtar 拒收的 RPM（payload 里的 cpio magic 被厂商改坏那种）。
rpm_payload_extract() {
  local pkg=$1 dest=$2
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$pkg" "$dest" <<'PYEOF'
import lzma, os, re, struct, sys

pkg, dest = sys.argv[1], sys.argv[2]
d = open(pkg, 'rb').read()

# ── 1. 定位 payload：跳过 lead(96) + 签名头 + 主头 ──
off = 96
if d[:4] != b'\xed\xab\xee\xdb':
    sys.exit(1)
for i in range(2):
    if d[off:off+4] != b'\x8e\xad\xe8\x01':
        sys.exit(1)
    nidx, hsize = struct.unpack('>II', d[off+8:off+16])
    total = 16 + nidx * 16 + hsize
    off = off + total if i == 1 else ((off + total + 7) & ~7)
payload = d[off:]

# ── 2. 定压缩格式并按需解压 ──
if payload[:6] == b'\xfd7zXZ\x00':
    raw = lzma.decompress(payload)
elif payload[:4] == b'\x28\xb5\x2f\xfd':
    import subprocess
    p = subprocess.run(['zstd', '-dc'], input=payload, capture_output=True)
    if p.returncode != 0:
        sys.exit(1)
    raw = p.stdout
elif payload[:2] == b'\x1f\x8b':
    import gzip
    raw = gzip.decompress(payload)
elif payload[:3] == b'BZh':
    import bz2
    raw = bz2.decompress(payload)
else:
    raw = payload       # 未压缩

# ── 3. 按 cpio newc 严格顺序解析 ──
# 只认真正的 cpio 流：magic 必须是 070701/070702，且每个头都得能读出
# 名字和数据。不做"全文找 magic"的模糊匹配——Chrome 那种非标准封装的
# 包里恰好散落着大量 07070X 伪头，模糊匹配会把垃圾当文件解出来。
MAGICS = (b'070701', b'070702')
if raw[:6] not in MAGICS:
    sys.exit(1)

pos = 0
n = len(raw)
written = 0
entries = 0
saw_trailer = False

while pos + 110 <= n:
    if raw[pos:pos+6] not in MAGICS:
        break                       # 到尾部填充了，正常收工
    hdr = pos
    try:
        fields = [int(raw[hdr + 6 + i*8: hdr + 14 + i*8], 16) for i in range(13)]
    except ValueError:
        sys.exit(1)
    mode, filesize = fields[1], fields[6]
    namesize = fields[11]
    if namesize <= 1 or namesize > 4096:
        sys.exit(1)
    name_bytes = raw[hdr + 110: hdr + 110 + namesize - 1]
    try:
        name = name_bytes.decode('utf-8')
    except UnicodeDecodeError:
        sys.exit(1)
    if any(ord(c) < 32 for c in name):
        sys.exit(1)
    data_off = (hdr + 110 + namesize + 3) & ~3
    if data_off + filesize > n:
        sys.exit(1)

    if name == 'TRAILER!!!':
        saw_trailer = True
        break

    entries += 1
    target = os.path.join(dest, name.lstrip('/'))
    st_mode = mode & 0o170000
    try:
        if st_mode == 0o040000:                       # 目录
            os.makedirs(target, exist_ok=True)
        elif st_mode == 0o120000:                     # 符号链接
            os.makedirs(os.path.dirname(target), exist_ok=True)
            link = raw[data_off:data_off + filesize].decode('utf-8', 'replace')
            if os.path.lexists(target):
                os.unlink(target)
            os.symlink(link, target)
        elif filesize > 0:                            # 普通文件
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, 'wb') as f:
                f.write(raw[data_off:data_off + filesize])
            os.chmod(target, mode & 0o7777)
            written += 1
    except OSError:
        pass

    pos = (data_off + filesize + 3) & ~3

# 判定成功与否，只看 cpio 结构本身：
# - 见到 TRAILER!!! 就是一份完整的 cpio 流，哪怕里面一条真条目都没有
#   （basesystem 这类纯元数据包的 payload 就只有 TRAILER）→ 成功
# - 有目录/软链但没有普通文件 → 成功
# - 解压出内容却既没条目也没 TRAILER → 失败（Chrome 那种非标准封装）
if entries == 0 and not saw_trailer:
    sys.exit(1)
print('\u89e3\u51fa %d \u4e2a\u6587\u4ef6 / %d \u6761\u76ee' % (written, entries))
PYEOF
}

# ---------- 2. 依赖检查 ----------
missing=(); unknown=()
# AppImage 自带运行时，flatpak 的 "依赖" 是它自己的 runtime（由 flatpak 解析）——
# 这两种都不该拿 deb/rpm 的映射表来查，查了只会全报 unknown。
if [[ $META_ONLY -eq 0 && "$FMT" == "appimage" ]]; then
  say "--- 依赖检查 ---"
  ok "AppImage 自带运行时，不需要系统依赖"
elif [[ $META_ONLY -eq 0 && "$FMT" == "flatpak" ]]; then
  say "--- 依赖检查 ---"
  ok "依赖由 flatpak 的 runtime 提供，安装时由 flatpak 自动拉取"
elif [[ $META_ONLY -eq 0 ]]; then
  say "--- 检查运行时依赖 ---"

  # 判断单个 rpm 依赖项；输出 "ok" / "missing:<Arch包>" / "unknown"
  classify_dep() {
    local d=$1
    case "$d" in
      /*)  [[ -e "$d" ]] && echo ok || echo unknown ;;
      *rpmlib*|*rtld*) echo ok ;;          # rpm 自身机制，不关系统的事
      *.so*)
        local so
        so="${d%%)*(64bit)}"               # 去掉尾部 (64bit)
        so="${so%%(*}"                     # 去掉 ABI 版本括号
        if [[ -n "${LDC_NAMES[$so]:-}" ]]; then
          echo ok                          # 系统里已经能解析这个 soname
        else
          local sp; sp=$(soname_pkg "$so")
          if [[ -n "$sp" ]]; then
            pacman -Qq "$sp" >/dev/null 2>&1 && echo ok || echo "missing:$sp"
          else
            echo "unknown:$so"
          fi
        fi ;;
      *)
        local sp; sp=$(soname_pkg "$d"); [[ -n "$sp" ]] || sp=$(cap_pkg "$d")
        if [[ -n "$sp" ]]; then
          pacman -Qq "$sp" >/dev/null 2>&1 && echo ok || echo "missing:$sp"
        elif pacman -Ssq "^${d}$" 2>/dev/null | grep -qx "$d"; then
          # 仓库里就有这个包名的包（只是没装）
          echo "missing:$d"
        else
          echo "unknown:$d"
        fi ;;
    esac
  }

  # 把 Rich 依赖组展开：RPM 的 "(a or b or c)" 在 raw 里写作 a or b or c
  # 我们的分隔符是 \x1f，组内元素直接以 " or " 相连
  IFS=$'\x1f' read -ra raw_deps <<< "$DEPENDS"
  for raw in "${raw_deps[@]}"; do
    raw=$(echo "$raw" | sed 's/^ *//; s/ *$//')
    [[ -z "$raw" ]] && continue

    if [[ "$FMT" == "deb" ]]; then
      d=$(echo "$raw" | sed 's/(.*)//; s/:any//; s/|.*//')
      d="${d%%:*}"                                  # 去掉 :any / :native 之类
      [ -z "$d" ] && continue
      an=$(arch_name "$d")
      if [[ -n "$an" ]]; then
        pacman -Qq "$an" >/dev/null 2>&1 || pacman -Qq "${an}-libs" >/dev/null 2>&1 || missing+=("$an")
      else
        unknown+=("$d")
      fi
      continue
    fi

    # rpm 的 Rich 依赖组长这样：(libcurl.so()(64bit),or,libcurl-gnutls.so.4()(64bit))
    # 组内元素用逗号分隔，"or" 是字面的元素名，需要去掉
    group=()
    if [[ "$raw" == "("* ]]; then
      inner="${raw#(}"; inner="${inner%)}"
      # rpm 给的是 "(a or b or c)"，rpm -qp --qf 也可能给 "(a,or,b)"。两种都换成 § 当分隔
      inner="${inner//,or,/§}"
      inner="${inner// or /§}"
      inner="${inner//,§/,|,}"
      inner="${inner//§/,|,}"
      IFS=',' read -ra parts <<< "$inner"
      for a in "${parts[@]}"; do
        [[ "$a" == "|" ]] && continue
        a=$(echo "$a" | sed 's/^ *//; s/ *$//')
        [[ "$a" == "or" || -z "$a" ]] || group+=("$a")
      done
    else
      group=("$raw")
    fi

    if [[ ${#group[@]} -le 1 ]]; then
      r=$(classify_dep "${group[0]:-$raw}")
      case "$r" in
        ok) ;;
        missing:*) missing+=("${r#missing:}") ;;
        unknown:*) unknown+=("${r#unknown:}") ;;
      esac
    else
      # OR 组：只要有一个满足就算过；全都缺才报第一个可映射的
      satisfied=0; first_missing=""; first_unknown=""
      for a in "${group[@]}"; do
        r=$(classify_dep "$a")
        case "$r" in
          ok) satisfied=1; break ;;
          missing:*) [[ -z "$first_missing" ]] && first_missing="${r#missing:}" ;;
          unknown:*) [[ -z "$first_unknown" ]] && first_unknown="${r#unknown:}" ;;
        esac
      done
      [[ $satisfied -eq 1 ]] || {
        [[ -n "$first_missing" ]] && missing+=("$first_missing") || unknown+=("$first_unknown")
      }
    fi
  done
  [[ ${#missing[@]} -gt 0 ]] && mapfile -t missing < <(printf '%s\n' "${missing[@]}" | sort -u)
  [[ ${#unknown[@]} -gt 0 ]] && mapfile -t unknown < <(printf '%s\n' "${unknown[@]}" | sort -u)
fi

# JSON 输出（给 GUI 前端用）：stdout 只有一行 JSON
if [[ $JSON_MODE -eq 1 ]]; then
  j_name() { local v=$1; v=${v//\\/\\\\}; v=${v//\"/\\\"}; printf '"%s"' "$v"; }
  printf '{"package":%s,"version":%s,"arch":%s,"format":%s,"file":%s,"depends_declared":%s,"arch_equivalent":%s' \
    "$(j_name "$PKG")" "$(j_name "$VER")" "$(j_name "$ARCH")" "$(j_name "$FMT")" "$(j_name "$PKGFILE")" \
    "$(j_name "$DEPS_SHOW")" "$(j_name "${ALT_HIT:-}")"
  printf ',"unknown_deps":['
  first=1
  for u in "${unknown[@]}"; do
    [[ $first -eq 1 ]] || printf ','
    printf '%s' "$(j_name "$u")"
    first=0
  done
  printf ']'
  printf ',"missing_deps":['
  first=1
  for m in "${missing[@]}"; do
    [[ $first -eq 1 ]] || printf ','
    printf '%s' "$(j_name "$m")"
    first=0
  done
  printf ']}'
  printf '\n'
  exit 0
fi

# AppImage / flatpak 不走映射表，上面已经分别给过结论，这里不要再补一句
if [[ "$FMT" == "deb" || "$FMT" == "rpm" ]]; then
  if [[ ${#unknown[@]} -gt 0 ]]; then
    warn "这 ${#unknown[@]} 项没收录映射，需自己确认：${unknown[*]}"
  fi
  if [[ ${#missing[@]} -gt 0 ]]; then
    warn "缺少 ${#missing[@]} 个依赖包，先用以下命令补齐："
    printf '  %ssudo pacman -S --needed %s%s\n' "$C_CYN" "${missing[*]}" "$C_OFF"
  elif [[ ${#unknown[@]} -eq 0 ]]; then
    ok "声明的依赖在系统里都找得到"
  fi
fi

[[ $DEPS_ONLY -eq 1 ]] && exit 0

# ---------- 3. 落地（每种格式语义不同）----------
DEST="$OPT/$PKG"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

shopt -s nullglob
declare -a mains=()
# 已有同名命令且不是我们自己的软链 → 先备份，绝不静默覆盖用户的东西
safe_link() {
  local target=$1 bn=$2 cur
  if [[ -e "$BIN/$bn" || -L "$BIN/$bn" ]]; then
    cur=$(readlink "$BIN/$bn" 2>/dev/null || true)
    if [[ "$cur" != "$OPT/"* ]]; then
      local bak="$BIN/$bn.bak-$(date +%Y%m%d-%H%M%S)"
      mv "$BIN/$bn" "$bak"
      warn "已有同名命令，原文件备份为 $(basename "$bak")"
    fi
  fi
  ln -sfn "$target" "$BIN/$bn"
  ok "$BIN/$bn → $target"
}

# 平铺的 deb / rpm：解包到 $TMP/root，再整体搬进 $DEST
stage_tree() {
  say "--- 解包到 $DEST ---"
  mkdir -p "$TMP/root"
  if [[ "$FMT" == "deb" ]]; then
    # dpkg-deb 解出来的权限/属主最准。
    # 没有 dpkg 时不能直接 bsdtar -xf 这个 .deb —— deb 本身是 ar 归档，
    # 那样只会取出 control.tar.xz / data.tar.xz 两个成员，不会展开文件树。
    # 必须先从 ar 里取出 data.tar.*，再让 bsdtar 解它。
    if ! dpkg-deb -x "$PKGFILE" "$TMP/root" 2>/dev/null; then
      bsdtar -xOf "$PKGFILE" "data.tar.*" 2>/dev/null | bsdtar -xf - -C "$TMP/root" 2>/dev/null \
        || die "解包失败（这个 deb 的 data.tar 读不出来，装个 dpkg 再试）"
    fi
  else
    mkdir -p "$TMP/root"
    # 首选：libarchive 直接吃 RPM（省一次解压落盘）
    if ! bsdtar -xf "$PKGFILE" -C "$TMP/root" 2>/dev/null; then
      # 回退：自己切 payload → 解压 → 当 cpio 读。
      # 有些厂商的 RPM（例如 Google Chrome）payload 里的 cpio magic 被改坏了，
      # libarchive 一律拒收，但逐条解析仍然能恢复出文件。
      say "bsdtar 读不了这个 RPM，退回手工解包…"
      rpm_payload_extract "$PKGFILE" "$TMP/root" \
        || die "解包失败（这个 RPM 的 payload 结构不标准，手工解析也读不了）"
    fi
  fi

  mkdir -p "$DEST"
  cp -a "$TMP/root/." "$DEST/"

  # 记录本包自己带的可执行/库目录，供 AppRun 式定位用
  find "$DEST" -name '*.so*' -type f 2>/dev/null > "$DEST/.pkg2local-solist"

  # ---------- 4. 链接可执行文件 ----------
  say "--- 链接命令到 $BIN ---"
  local exe
  for exe in "$DEST"/usr/bin/* "$DEST"/opt/*/bin/*; do
    [[ -f "$exe" && -x "$exe" ]] || continue
    safe_link "$exe" "$(basename "$exe")"
    mains+=("$exe")
  done
  for exe in "$DEST"/usr/local/bin/*; do
    [[ -f "$exe" && -x "$exe" ]] || continue
    safe_link "$exe" "$(basename "$exe")"
  done
}

# AppImage：自包含，不需要「解包安装」。
# 正确语义是把它当一个整体搬进 ~/.local/opt，再链命令 + 生成桌面条目。
# 抄而不是移：用户原来那个文件留在原地，卸载时也不碰它。
install_appimage() {
  say "--- 安装 AppImage 到 $DEST ---"
  mkdir -p "$DEST" "$BIN"
  local target="$DEST/$(basename "$PKGFILE")"
  # btrfs / xfs 上 reflink 是零拷贝；不支持的 fs 自动退化成普通复制
  cp --reflink=auto --preserve=mode,timestamps "$PKGFILE" "$target" 2>/dev/null \
    || cp --preserve=mode,timestamps "$PKGFILE" "$target" \
    || die "拷不动这个 AppImage"
  chmod +x "$target"
  ok "已放到 $target"

  # desktop 里的 Exec 首词是 AppRun，对用户没意义，命令名用应用名
  local cmd
  cmd=$(printf '%s' "$PKG" | tr -d ' ')
  safe_link "$target" "$cmd"
  mains+=("$target")

  say "--- 导入桌面条目 ---"
  # --appimage-extract 把 squashfs-root 解到【当前工作目录】，
  # 不切目录会污染用户当前所在的文件夹；而且一次只能传一个 pattern（传两个就 exit=1）。
  local wd src out ic png
  wd=$(mktemp -d) || die "建不了临时目录"
  ( cd "$wd" && "$target" --appimage-extract '*.desktop' ) >/dev/null 2>&1
  src=$(find "$wd/squashfs-root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -1)
  if [[ -n "$src" ]]; then
    out="$APPS/$(basename "$src")"
    # Exec 首词换成绝对路径，%U / %F 这些占位符原样留着
    sed -e "s|^Exec=[^ ]*|Exec=$target|" \
        -e "s|^TryExec=.*|TryExec=$target|" "$src" > "$out"

    ic=$(sed -n 's/^Icon=//p' "$out" | head -1)
    if [[ -n "$ic" && "$ic" != /* ]]; then
      # 图标位置各家不一样：顶层可能只是个指向 hicolor/<尺寸>/apps/ 的软链。
      # 软链单独抽出来是断的（cp 会报 stat 失败），所以第二遍把整个 icons 目录抽出来，
      # 再按真实文件大小挑最大的那个 —— 尺寸越大的越清晰。
      ( cd "$wd" && rm -rf squashfs-root && "$target" --appimage-extract "${ic}.png" ) >/dev/null 2>&1
      png=""
      if [[ -f "$wd/squashfs-root/${ic}.png" ]]; then
        png="$wd/squashfs-root/${ic}.png"
      else
        ( cd "$wd" && rm -rf squashfs-root && "$target" --appimage-extract 'usr/share/icons/*' ) >/dev/null 2>&1
        png=$(find "$wd/squashfs-root" -name '*.png' -type f -printf '%s %p\n' 2>/dev/null \
              | sort -n | tail -1 | cut -d' ' -f2-)
      fi
      if [[ -n "$png" && -f "$png" ]]; then
        mkdir -p "$ICONS"
        cp -f "$png" "$ICONS/$(basename "$png")"
        sed -i "s|^Icon=.*|Icon=$ICONS/$(basename "$png")|" "$out"
        ok "图标 → $ICONS/$(basename "$png")"
      else
        warn "这个 AppImage 里没抽到图标，应用菜单会显示默认图标"
      fi
    fi
    ok "$out"
  else
    warn "这个 AppImage 里没有 .desktop，只链了命令，应用菜单里不会出现"
  fi
  rm -rf "$wd"

  # AppImage 是压缩镜像不是可解析的 ELF，没有包级依赖可查
  find "$DEST" -name '*.so*' -type f 2>/dev/null > "$DEST/.pkg2local-solist"
}

# flatpak bundle：完全委派给 flatpak。
# runtime、沙箱、图标、桌面条目都由它管，我们只调用 + 记账。
install_flatpak() {
  command -v flatpak >/dev/null 2>&1 || die "装 .flatpak 需要 flatpak：sudo pacman -S flatpak"
  say "--- 交给 flatpak 安装（--user 域，不需要 root）---"
  if ! flatpak install --user -y --noninteractive --bundle "$PKGFILE"; then
    die "flatpak 安装失败（常见原因是缺 runtime，先跑 flatpak install flathub <runtime>）"
  fi
  # 桌面条目和图标由 flatpak 自己导出到 ~/.local/share/flatpak/exports，不用我们管
  local exe="$PREFIX/share/flatpak/exports/bin/$PKG"
  [[ -x "$exe" ]] && mains+=("$exe")
  # flatpak 的包不在 $OPT 下，靠 STATE 里的清单记住"这是 pkg2local 装的"，
  # 否则卸载时会找不到、GUI 列表里也不会显示
  mkdir -p "$STATE" "$DEST"
  grep -qxF "$PKG" "$STATE/flatpaks" 2>/dev/null || printf '%s\n' "$PKG" >> "$STATE/flatpaks"
  ok "flatpak 已装：$PKG"
}

mkdir -p "$BIN" "$APPS" "$ICONS"
case "$FMT" in
  deb|rpm)   stage_tree ;;
  appimage)  install_appimage ;;
  flatpak)   install_flatpak ;;
esac

# ---------- 5. 桌面条目与图标（只对 deb / rpm 有意义）----------
# AppImage 和 flatpak 的桌面条目在各自的 install_* 里已经处理完了。
if [[ "$FMT" == "deb" || "$FMT" == "rpm" ]]; then
say "--- 导入桌面条目 ---"
for dt in "$DEST"/usr/share/applications/*.desktop "$DEST"/opt/*/*.desktop; do
  [[ -f "$dt" ]] || continue
  out="$APPS/$(basename "$dt")"
  # 已有同名桌面条目且不是我们装的 → 备份，不静默覆盖
  if [[ -e "$out" && ! -f "$DEST/$dt" ]]; then
    case "$(readlink -f "$out" 2>/dev/null)" in
      "$OPT"/*) ;;
      *) cp -a "$out" "$out.bak-$(date +%Y%m%d-%H%M%S)" && warn "已有同名桌面条目，备份为 $(basename "$out").bak-*" ;;
    esac
  fi
  # Exec 首词换成绝对路径
  first=$(grep -m1 '^Exec=' "$dt" | sed 's/^Exec=//' | awk '{print $1}')
  abs=""
  for m in "${mains[@]}"; do
    [[ "$(basename "$m")" == "$first" ]] && abs="$m" && break
  done
  if [[ -n "$abs" ]]; then
    sed -e "s|^Exec=$first|Exec=$abs|" -e "s|^TryExec=.*|TryExec=$abs|" "$dt" > "$out"
  else
    cp "$dt" "$out"
  fi
  # Icon= 若是相对名，指向包内 png/svg
  ic=$(grep -m1 '^Icon=' "$out" | sed 's/^Icon=//')
  if [[ -n "$ic" && "$ic" != /* ]]; then
    found=$(find "$DEST" -iname "${ic}.png" -o -iname "${ic}.svg" 2>/dev/null | head -1)
    [[ -n "$found" ]] && sed -i "s|^Icon=.*|Icon=$found|" "$out"
  fi
  ok "$out"
done
find "$DEST/usr/share/icons" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | while read -r d; do
  cp -rn "$d" "$ICONS/" 2>/dev/null
done
[[ -d "$DEST/usr/share/pixmaps" ]] && cp -rn "$DEST/usr/share/pixmaps/." "$ICONS/" 2>/dev/null
fi

# ---------- 6. 动静态检查 ----------
say "--- 检查可执行文件的缺失共享库 ---"
bad=0
for exe in "${mains[@]}"; do
  miss=$(ldd "$exe" 2>/dev/null | grep 'not found' || true)
  if [[ -n "$miss" ]]; then
    bad=1
    warn "$(basename "$exe") 缺库:"
    echo "$miss" | sed 's/^/    /'
  fi
done
[[ $bad -eq 0 ]] && ok "所有主程序可解析全部 .so"

# ---------- 6.5 记录元数据（GUI 靠它列出已装）----------
{
  printf '{\n'
  printf '  "package": "%s",\n' "$PKG"
  printf '  "version": "%s",\n' "$VER"
  printf '  "arch": "%s",\n' "$ARCH"
  printf '  "format": "%s",\n' "$FMT"
  printf '  "source": "%s",\n' "$PKGFILE"
  printf '  "prefix": "%s",\n' "$DEST"
  printf '  "installed_at": "%s",\n' "$(date -Iseconds)"
  printf '  "executables": ['
  first=1
  for m in "${mains[@]}"; do
    [[ $first -eq 1 ]] || printf ', '
    printf '"%s"' "$(basename "$m")"
    first=0
  done
  printf ']\n}\n'
} > "$DEST/.pkg2local.json"

# ---------- 7. 收尾 ----------
command -v update-desktop-database >/dev/null && update-desktop-database "$APPS" 2>/dev/null
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t -f "$ICONS/hicolor" 2>/dev/null
say ""
ok "装好了：$DEST"
echo "  卸载: $PROG --uninstall $PKG"
# 后续排错提示只对 deb / rpm 有意义：
# AppImage 自带运行时，flatpak 用的是它自己的 runtime —— 它们都不会踩 /usr 硬编码的坑
if [[ "$FMT" == "deb" || "$FMT" == "rpm" ]]; then
  echo "  若应用报「找不到 /usr/xxx」，说明它硬编码了 /usr 路径 —— 改用："
  echo "    sudo pacman -S distrobox podman && distrobox create -i ubuntu:24.04 -n pkgbox"
  echo "    distrobox enter pkgbox -- sudo dpkg -i $(basename "$PKGFILE")"
fi
