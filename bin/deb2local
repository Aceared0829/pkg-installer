#!/usr/bin/env bash
# deb2local — 把 .deb 装进 ~/.local，不需要 root，不改 pacman 数据库
#
#   deb2local 包.deb          # 安装（解包到 ~/.local/opt，链接 bin，导入桌面图标）
#   deb2local 包.deb --deps   # 只检查依赖缺哪些，不安装
#   deb2local --uninstall 名  # 卸载（删 ~/.local/opt/名 及其链接）
#
# 适合：自包含的 Electron / Tauri / Go 单文件应用（绝大多数国产客户端）。
# 不适合：依赖 /usr 绝对路径、装 systemd 服务或内核模块的包 —— 那种用 distrobox。
set -uo pipefail

VERSION="1.0.0"
PROG=$(basename "$0")
PREFIX="$HOME/.local"
OPT="$PREFIX/opt"
BIN="$PREFIX/bin"
APPS="$PREFIX/share/applications"
ICONS="$PREFIX/share/icons"

# 尊重 NO_COLOR，方便 GUI 前端调用时剥掉 ANSI
if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
  C_RED=""; C_GRN=""; C_YEL=""; C_CYN=""; C_BLD=""; C_OFF=""
else
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'; C_BLD=$'\033[1m'; C_OFF=$'\033[0m'
fi
OUTFD=1
say() { if [[ $OUTFD -eq 1 ]]; then echo "$*"; else echo "$*" >&2; fi; }
die() { printf '%s错误:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }
ok()  { if [[ $OUTFD -eq 1 ]]; then printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; else printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*" >&2; fi; }
warn(){ if [[ $OUTFD -eq 1 ]]; then printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*"; else printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; fi; }

usage() {
  cat <<'EOF'
deb2local — 把 .deb 装进 ~/.local，不需要 root，不改 pacman 数据库

  deb2local 包.deb          安装（解包到 ~/.local/opt，链接 bin，导入桌面图标）
  deb2local 包.deb -y       安装，不询问
  deb2local 包.deb --deps   只检查依赖缺哪些，不安装
  deb2local --uninstall 名  卸载（删 ~/.local/opt/名 及其链接）
  deb2local --version       显示版本

适合：自包含的 Electron / Tauri / Go 单文件应用（绝大多数国产客户端）。
不适合：依赖 /usr 绝对路径、装 systemd 服务或内核模块的包 —— 那种用 distrobox。
EOF
  exit 0
}

# ---------- deb 依赖名 → Arch 包名 ----------
arch_name() {
  case "$1" in
    libwebkit2gtk-4.1-0)         echo webkit2gtk-4.1 ;;
    libwebkit2gtk-4.0-37)        echo webkit2gtk ;;
    libgtk-3-0)                  echo gtk3 ;;
    libgtk-4-1)                  echo gtk4 ;;
    libayatana-appindicator3-1)  echo libayatana-appindicator ;;
    libappindicator3-1)          echo libappindicator-gtk3 ;;
    libnotify4)                  echo libnotify ;;
    libnss3)                     echo nss ;;
    libxss1)                     echo libxss ;;
    libxtst6)                    echo libxtst ;;
    libasound2|libasound2t64)    echo alsa-lib ;;
    libgbm1)                     echo mesa ;;
    libdrm2)                     echo libdrm ;;
    libxkbcommon0)               echo libxkbcommon ;;
    libsecret-1-0)               echo libsecret ;;
    libcups2)                    echo cups ;;
    libpango-1.0-0)              echo pango ;;
    libcairo2)                   echo cairo ;;
    libatk1.0-0)                 echo atk ;;
    libatk-bridge2.0-0)          echo at-spi2-core ;;
    libgdk-pixbuf-2.0-0|libgdk-pixbuf2.0-0) echo gdk-pixbuf2 ;;
    libglib2.0-0)                echo glib2 ;;
    libfontconfig1)              echo fontconfig ;;
    libfreetype6)                echo freetype2 ;;
    libdbus-1-3)                 echo dbus ;;
    libexpat1)                   echo expat ;;
    libuuid1)                    echo util-linux-libs ;;
    liblzma5)                    echo xz ;;
    libzstd1)                    echo zstd ;;
    libdouble-conversion3)       echo double-conversion ;;
    libxcb1)                     echo libxcb ;;
    libx11-6)                    echo libx11 ;;
    libxext6)                    echo libxext ;;
    libxrandr2)                  echo libxrandr ;;
    libxi6)                      echo libxi ;;
    libxcursor1)                 echo libxcursor ;;
    libxcomposite1)              echo libxcomposite ;;
    libxdamage1)                 echo libxdamage ;;
    libxfixes3)                  echo libxfixes ;;
    libxinerama1)                echo libxinerama ;;
    libegl1)                     echo libglvnd ;;
    libgl1)                      echo libglvnd ;;
    libqt6core6)                 echo qt6-base ;;
    libqt6gui6)                  echo qt6-base ;;
    libqt6widgets6)              echo qt6-base ;;
    libqt6network6)              echo qt6-base ;;
    libqt5core5a)                echo qt5-base ;;
    libqt5gui5)                  echo qt5-base ;;
    libqt5widgets5)              echo qt5-base ;;
    libqt5network5)              echo qt5-base ;;
    libssl3|libssl3t64)          echo openssl ;;
    libcrypto3)                  echo openssl ;;
    libcurl4)                    echo curl ;;
    libffi8)                     echo libffi ;;
    libpcre2-8-0)                echo pcre2 ;;
    libselinux1)                 echo libselinux ;;
    libcap2)                     echo libcap ;;
    libsystemd0)                 echo systemd-libs ;;
    libgcrypt20)                 echo libgcrypt ;;
    libgpg-error0)               echo libgpg-error ;;
    libudev1)                    echo systemd-libs ;;
    libpulse0)                   echo libpulse ;;
    libpipewire-0.3-0)           echo pipewire ;;
    libsdl2-2.0-0)               echo sdl2 ;;
    libvulkan1)                  echo vulkan-icd-loader ;;
    libglu1-mesa)                echo glu ;;
    libgstreamer1.0-0)           echo gstreamer ;;
    libgstreamer-plugins-base1.0-0) echo gst-plugins-base-libs ;;
    libavcodec59|libavcodec60|libavcodec61) echo ffmpeg ;;
    libavformat59|libavformat60|libavformat61) echo ffmpeg ;;
    libavutil57|libavutil58|libavutil59) echo ffmpeg ;;
    libswresample4|libswresample5) echo ffmpeg ;;
    libopus0)                    echo opus ;;
    libvpx7|libvpx9)             echo libvpx ;;
    libsrtp2-1|libsrtp3)         echo libsrtp ;;
    *) echo "" ;;
  esac
}

# ---------- 卸载 ----------
if [[ "${1:-}" == "--uninstall" ]]; then
  name="${2:-}"; [[ -n "$name" ]] || die "用法: $PROG --uninstall <名称>"
  [[ -d "$OPT/$name" ]] || die "没装过: $OPT/$name"
  # 先删链接再删目录，否则 readlink -f 在目录消失后解析为空
  for l in "$BIN"/*; do
    [[ -L "$l" ]] || continue
    tgt=$(readlink "$l")
    [[ "$tgt" == "$OPT/$name/"* ]] && rm -f "$l" && echo "  移除 $l"
  done
  # 桌面条目可能和包名不同（例如 wechat-deb-test 里装的是 wechat.desktop），
  # 所以按 Exec=/Icon= 指向本包目录来判定，而不是按文件名
  for dt in "$APPS"/*.desktop; do
    [[ -f "$dt" ]] || continue
    if grep -qE "^(Exec|TryExec|Icon)=.*$OPT/$name/" "$dt" 2>/dev/null; then
      rm -f "$dt" && echo "  移除 $dt"
    fi
  done
  rm -f "$APPS/$name.desktop"
  find "$ICONS" -maxdepth 6 \( -name "$name.png" -o -name "$name.svg" -o -name "${name}_*.png" \) -print -delete 2>/dev/null
  rm -rf "$OPT/$name"
  ok "已卸载 $name"
  exit 0
fi

# ---------- 参数 ----------
DEPS_ONLY=0; ASSUME_YES=0; JSON_MODE=0; DEB=""
for a in "$@"; do
  case "$a" in
    -h|--help) usage ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    --deps)    DEPS_ONLY=1 ;;
    --json)    JSON_MODE=1; DEPS_ONLY=1 ;;
    -y|--yes)  ASSUME_YES=1 ;;
    -*)        die "未知参数: $a" ;;
    *)         DEB="$a" ;;
  esac
done
# JSON 模式下 stdout 只留最后一行 JSON，其余人话全部改走 stderr
[[ $JSON_MODE -eq 1 ]] && { OUTFD=0; DEPS_ONLY=1; }

[[ -n "$DEB" ]] || usage
[[ -f "$DEB" ]] || die "找不到文件: $DEB"
command -v dpkg-deb >/dev/null || die "缺 dpkg-deb（sudo pacman -S dpkg）"

PKG=$(dpkg-deb -f "$DEB" Package 2>/dev/null) || die "不是合法的 .deb: $DEB"
VER=$(dpkg-deb -f "$DEB" Version 2>/dev/null)
ARCH=$(dpkg-deb -f "$DEB" Architecture 2>/dev/null)
DEPENDS=$(dpkg-deb -f "$DEB" Depends 2>/dev/null | tr -d '\n')

say "$(printf '%s%s%s 版本 %s  架构 %s' "$C_BLD" "$PKG" "$C_OFF" "$VER" "$ARCH")"
[[ -n "$DEPENDS" ]] && say "声明依赖: $DEPENDS"

# ---------- 1. 先查 Arch 有没有现成的 ----------
say "--- 查 Arch 生态是否有对应包 ---"
lower=$(echo "$PKG" | tr 'A-Z' 'a-z')
ALT_HIT=""
# paru 的 AUR 搜索不支持 ^$ 锚点，只能取回名字段做精确比对
find_repo() {   # $1=candidate -> 打印 "仓库/包名" 或空
  local c=$1 line n
  while IFS= read -r line; do
    n=${line%% *}; n=${n#*/}
    [[ "$n" == "$c" ]] && { echo "${line%% *}"; return; }
  done < <(pacman -Ss "$c" 2>/dev/null)
}
find_aur() {
  local c=$1 line n
  while IFS= read -r line; do
    [[ "$line" == aur/* ]] || continue
    n=${line%% *}; n=${n#aur/}
    [[ "$n" == "$c" ]] && { echo "aur/$n"; return; }
  done < <(timeout 15 paru -Ss "$c" 2>/dev/null)
}
for cand in "$PKG" "$lower" "${PKG%-bin}" "${lower%-bin}"; do
  hit=$(find_repo "$cand")
  if [[ -n "$hit" ]]; then
    ALT_HIT="$hit"; ALT_KIND="repo"
    ok "仓库已有: $hit  —— 建议直接 paru -S ${hit#*/}，别折腾 deb"
    [[ $DEPS_ONLY -eq 0 && $ASSUME_YES -eq 0 ]] && { echo "仍要继续装这个 deb？按 Ctrl-C 退出，或回车继续。"; read -r _; }
    break
  fi
  if command -v paru >/dev/null 2>&1; then
    hit=$(find_aur "$cand")
    if [[ -n "$hit" ]]; then
      ALT_HIT="$hit"; ALT_KIND="aur"
      ok "AUR 已有: $hit  —— 建议直接 paru -S ${hit#*/}，别折腾 deb"
      [[ $DEPS_ONLY -eq 0 && $ASSUME_YES -eq 0 ]] && { echo "仍要继续装这个 deb？按 Ctrl-C 退出，或回车继续。"; read -r _; }
      break
    fi
  fi
done

# ---------- 2. 依赖检查 ----------
say "--- 检查运行时依赖 ---"
missing=()
unknown=()
IFS=',' read -ra deps <<< "$DEPENDS"
for d in "${deps[@]}"; do
  d=$(echo "$d" | sed 's/^ *//; s/ *$//; s/(.*)//; s/:any//')
  [[ -z "$d" ]] && continue
  an=$(arch_name "$d")
  if [[ -n "$an" ]]; then
    if pacman -Qq "$an" >/dev/null 2>&1 || pacman -Qq "${an}-libs" >/dev/null 2>&1; then
      :
    else
      missing+=("$an")
    fi
  else
    unknown+=("$d")
  fi
done
[[ ${#missing[@]} -gt 0 ]] && mapfile -t missing < <(printf '%s\n' "${missing[@]}" | sort -u)

# JSON 输出（给 GUI 前端用）：stdout 只有一行 JSON
if [[ $JSON_MODE -eq 1 ]]; then
  j_name() { local v=$1; v=${v//\\/\\\\}; v=${v//\"/\\\"}; printf '"%s"' "$v"; }
  printf '{"package":%s,"version":%s,"arch":%s,"file":%s,"depends_declared":%s,"arch_equivalent":%s' \
    "$(j_name "$PKG")" "$(j_name "$VER")" "$(j_name "$ARCH")" "$(j_name "$DEB")" \
    "$(j_name "$DEPENDS")" "$(j_name "${ALT_HIT:-}")"
  printf ',"unknown_deps":['
  first=1
  for u in "${unknown[@]}"; do
    [[ $first -eq 1 ]] || printf ','
    printf '%s' "$(j_name "$u")"
    first=0
  done
  printf ']'
  printf ',"missing_deps":['
  first=1
  for m in "${missing[@]}"; do
    [[ $first -eq 1 ]] || printf ','
    printf '%s' "$(j_name "$m")"
    first=0
  done
  printf ']}'
  printf '\n'
  exit 0
fi

if [[ ${#unknown[@]} -gt 0 ]]; then
  warn "这 ${#unknown[@]} 项没收录映射，需自己确认：${unknown[*]}"
fi
if [[ ${#missing[@]} -gt 0 ]]; then
  warn "缺少 ${#missing[@]} 个依赖包，先用以下命令补齐："
  printf '  %ssudo pacman -S --needed %s%s\n' "$C_CYN" "${missing[*]}" "$C_OFF"
elif [[ ${#unknown[@]} -eq 0 ]]; then
  ok "声明的依赖在系统里都找得到"
fi

[[ $DEPS_ONLY -eq 1 ]] && exit 0

# ---------- 3. 解包 ----------
DEST="$OPT/$PKG"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
say "--- 解包到 $DEST ---"
dpkg-deb -x "$DEB" "$TMP/root" || die "解包失败"

mkdir -p "$DEST" "$BIN" "$APPS" "$ICONS"
cp -a "$TMP/root/." "$DEST/"

# 记录本包自己带的可执行/库目录，供 AppRun 式定位用
find "$DEST" -name '*.so*' -type f 2>/dev/null > "$DEST/.deb2local-solist"

# ---------- 4. 链接可执行文件 ----------
say "--- 链接命令到 $BIN ---"
shopt -s nullglob
declare -a mains=()
# 已有同名命令且不是我们自己的软链 → 先备份，绝不静默覆盖用户的东西
safe_link() {
  local target=$1 bn=$2 cur
  if [[ -e "$BIN/$bn" || -L "$BIN/$bn" ]]; then
    cur=$(readlink "$BIN/$bn" 2>/dev/null || true)
    if [[ "$cur" != "$OPT/"* ]]; then
      local bak="$BIN/$bn.bak-$(date +%Y%m%d-%H%M%S)"
      mv "$BIN/$bn" "$bak"
      warn "已有同名命令，原文件备份为 $(basename "$bak")"
    fi
  fi
  ln -sfn "$target" "$BIN/$bn"
  ok "$BIN/$bn → $target"
}
for exe in "$DEST"/usr/bin/* "$DEST"/opt/*/bin/*; do
  [[ -f "$exe" && -x "$exe" ]] || continue
  safe_link "$exe" "$(basename "$exe")"
  mains+=("$exe")
done
for exe in "$DEST"/usr/local/bin/*; do
  [[ -f "$exe" && -x "$exe" ]] || continue
  safe_link "$exe" "$(basename "$exe")"
done

# ---------- 5. 桌面条目与图标 ----------
say "--- 导入桌面条目 ---"
for dt in "$DEST"/usr/share/applications/*.desktop "$DEST"/opt/*/*.desktop; do
  [[ -f "$dt" ]] || continue
  out="$APPS/$(basename "$dt")"
  # 已有同名桌面条目且不是我们装的 → 备份，不静默覆盖
  if [[ -e "$out" && ! -f "$DEST/$dt" ]]; then
    case "$(readlink -f "$out" 2>/dev/null)" in
      "$OPT"/*) ;;
      *) cp -a "$out" "$out.bak-$(date +%Y%m%d-%H%M%S)" && warn "已有同名桌面条目，备份为 $(basename "$out").bak-*" ;;
    esac
  fi
  # Exec 首词换成绝对路径
  first=$(grep -m1 '^Exec=' "$dt" | sed 's/^Exec=//' | awk '{print $1}')
  abs=""
  for m in "${mains[@]}"; do
    [[ "$(basename "$m")" == "$first" ]] && abs="$m" && break
  done
  if [[ -n "$abs" ]]; then
    sed -e "s|^Exec=$first|Exec=$abs|" -e "s|^TryExec=.*|TryExec=$abs|" "$dt" > "$out"
  else
    cp "$dt" "$out"
  fi
  # Icon= 若是相对名，指向包内 png/svg
  ic=$(grep -m1 '^Icon=' "$out" | sed 's/^Icon=//')
  if [[ -n "$ic" && "$ic" != /* ]]; then
    found=$(find "$DEST" -iname "${ic}.png" -o -iname "${ic}.svg" 2>/dev/null | head -1)
    [[ -n "$found" ]] && sed -i "s|^Icon=.*|Icon=$found|" "$out"
  fi
  ok "$out"
done
find "$DEST/usr/share/icons" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | while read -r d; do
  cp -rn "$d" "$ICONS/" 2>/dev/null
done
[[ -d "$DEST/usr/share/pixmaps" ]] && cp -rn "$DEST/usr/share/pixmaps/." "$ICONS/" 2>/dev/null

# ---------- 6. 动静态检查 ----------
say "--- 检查可执行文件的缺失共享库 ---"
bad=0
for exe in "${mains[@]}"; do
  miss=$(ldd "$exe" 2>/dev/null | grep 'not found' || true)
  if [[ -n "$miss" ]]; then
    bad=1
    warn "$(basename "$exe") 缺库:"
    echo "$miss" | sed 's/^/    /'
  fi
done
[[ $bad -eq 0 ]] && ok "所有主程序可解析全部 .so"

# ---------- 6.5 记录元数据（GUI 靠它列出已装）----------
{
  printf '{\n'
  printf '  "package": "%s",\n' "$PKG"
  printf '  "version": "%s",\n' "$VER"
  printf '  "arch": "%s",\n' "$ARCH"
  printf '  "source": "%s",\n' "$DEB"
  printf '  "prefix": "%s",\n' "$DEST"
  printf '  "installed_at": "%s",\n' "$(date -Iseconds)"
  printf '  "executables": ['
  first=1
  for m in "${mains[@]}"; do
    [[ $first -eq 1 ]] || printf ', '
    printf '"%s"' "$(basename "$m")"
    first=0
  done
  printf ']\n}\n'
} > "$DEST/.deb2local.json"

# ---------- 7. 收尾 ----------
command -v update-desktop-database >/dev/null && update-desktop-database "$APPS" 2>/dev/null
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t -f "$ICONS/hicolor" 2>/dev/null
say ""
ok "装好了：$DEST"
echo "  卸载: $PROG --uninstall $PKG"
echo "  若应用报「找不到 /usr/xxx」，说明它硬编码了 /usr 路径 —— 改用："
echo "    sudo pacman -S distrobox podman && distrobox create -i ubuntu:24.04 -n debbox"
echo "    distrobox enter debbox -- sudo dpkg -i $(basename "$DEB")"
