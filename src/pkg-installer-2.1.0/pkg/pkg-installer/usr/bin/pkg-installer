#!/usr/bin/env python3
"""
pkg 安装器 — CachyOS/Arch 上的 .deb / .rpm / .AppImage / .flatpak 图形前端
套在 ~/.local/bin/pkg2local 外面的 GTK4 + libadwaita 壳。

依赖（都已装在系统里）：python-gobject, gtk4, libadwaita, dpkg, libarchive
"""

import json
import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gdk", "4.0")

from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.aceared.pkginstaller"
TITLE = "pkg 安装器"
VERSION = "2.1.0"

# 认的包格式 → 显示名。新增格式只改这里 + 后端的 detect_format
FORMATS = {
    ".deb": "deb",
    ".rpm": "rpm",
    ".appimage": "appimage",
    ".flatpak": "flatpak",
    ".flatpakref": "flatpak",
}
DEFAULT_PICK = ("deb", "rpm", "appimage", "flatpak")
# 界面上要展示的扩展名（顺序即过滤器里的顺序）
DISPLAY_EXTS = (".deb", ".rpm", ".AppImage", ".flatpak")


def pkg_format(path: str) -> str:
    """按扩展名给格式；返回空串表示不认。"""
    return FORMATS.get(Path(path).suffix.lower(), "")


def find_backend() -> str:
    """后端 pkg2local 的定位顺序：环境变量 → 脚本同目录 → PATH → ~/.local/bin"""
    # 新变量名优先，旧变量名留作兜底（老脚本里还写着 DEB2LOCAL）
    for var in ("PKG2LOCAL", "DEB2LOCAL"):
        env = os.environ.get(var)
        if env and os.path.isfile(env):
            return env
    here = Path(__file__).resolve().parent
    for name in ("pkg2local", "deb2local"):
        if (here / name).is_file():
            return str(here / name)
    for name in ("pkg2local", "deb2local"):
        found = shutil.which(name)
        if found:
            return found
    return str(Path.home() / ".local/bin/pkg2local")


BACKEND = find_backend()
OPT_DIR = Path.home() / ".local/opt"
BIN_DIR = Path.home() / ".local/bin"
APPS_DIR = Path.home() / ".local/share/applications"

C_GRN = "#26a269"
C_YEL = "#e5a50a"
C_RED = "#c01c28"
C_DIM = "#8f8f8f"


# ─────────────────────────── 元数据读取 ───────────────────────────
def read_pkg_meta(path: str) -> dict:
    """让后端出包头 JSON（--meta 不联网、不查依赖，够快给 UI 立刻显示）。

    deb 和 rpm 走同一条路，读包头的逻辑只有后端一份，不会漂移。
    """
    ok = True
    out = {}
    try:
        r = subprocess.run(
            [BACKEND, path, "--meta"],
            capture_output=True, text=True, timeout=20,
        )
        if r.returncode != 0:
            ok = False
        else:
            data = json.loads(r.stdout.strip().splitlines()[-1])
            out = {
                "Package": data.get("package", ""),
                "Version": data.get("version", ""),
                "Architecture": data.get("arch", ""),
                "Depends": data.get("depends_declared", ""),
                "_format": data.get("format", ""),
            }
    except Exception:
        ok = False
    out["_valid"] = ok
    out["_file"] = path
    if not out.get("_format"):
        out["_format"] = pkg_format(path)
    try:
        out["_size"] = os.path.getsize(path)
    except OSError:
        out["_size"] = 0
    return out


def human_size(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n} B"


def list_installed() -> list[dict]:
    """扫 ~/.local/opt/*/.pkg2local.json（兼容 1.x 留下的 .deb2local.json）"""
    items = []
    if not OPT_DIR.is_dir():
        return items
    for d in sorted(OPT_DIR.iterdir()):
        for name in (".pkg2local.json", ".deb2local.json"):
            meta = d / name
            if not meta.is_file():
                continue
            try:
                m = json.loads(meta.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                continue
            m.setdefault("format", "deb" if name == ".deb2local.json" else "")
            items.append(m)
            break
    return items


# ─────────────────────────── 拖放区 ───────────────────────────
class DropZone(Gtk.Box):
    """空态时显示的虚线大框，提示拖入安装包"""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add_css_class("card")
        self.set_valign(Gtk.Align.CENTER)
        self.set_margin_top(48)
        self.set_margin_bottom(48)
        self.set_margin_start(24)
        self.set_margin_end(24)

        icon = Gtk.Image.new_from_icon_name("package-x-generic-symbolic")
        icon.set_pixel_size(96)
        icon.add_css_class("dim-label")
        self.append(icon)

        t = Gtk.Label.new("把安装包拖进来")
        t.add_css_class("title-1")
        self.append(t)

        s = Gtk.Label.new(".deb / .rpm / .AppImage / .flatpak 都认\n也会先查 Arch 生态有没有现成的包，能直接用就不折腾它")
        s.add_css_class("dim-label")
        s.set_wrap(True)
        s.set_justify(Gtk.Justification.CENTER)
        self.append(s)

        btn = Gtk.Button(label="选择文件…")
        btn.add_css_class("pill")
        btn.add_css_class("suggested-action")
        btn.set_halign(Gtk.Align.CENTER)
        btn.set_margin_top(8)
        self.append(btn)
        self.btn = btn


# ─────────────────────────── 主窗口 ───────────────────────────
class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=TITLE)
        self.set_default_size(880, 720)
        self.current_meta = None
        self.busy = False

        self.toast = Adw.ToastOverlay()
        self.set_content(self.toast)

        self.toolbar = Adw.ToolbarView()
        self.toast.set_child(self.toolbar)

        # ── 顶栏 ──
        self.header = Adw.HeaderBar()
        self.toolbar.add_top_bar(self.header)

        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher()
        switcher.set_stack(self.stack)
        switcher.set_policy(Adw.ViewSwitcherPolicy.WIDE)
        self.header.set_title_widget(switcher)

        self.btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        self.btn_refresh.set_tooltip_text("刷新已安装列表")
        self.btn_refresh.connect("clicked", lambda *_: self.refresh_installed())
        self.header.pack_end(self.btn_refresh)

        self.toolbar.set_content(self.stack)

        # ── 页 1：安装 ──
        self.stack.add_titled(self._build_install_page(), "install", "安装")

        # ── 页 2：已安装 ──
        self.stack.add_titled(self._build_installed_page(), "installed", "已安装")

        # ── 拖放 ──
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.connect("drop", self._on_drop)
        self.add_controller(drop)

        # 快捷键 Ctrl+O
        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self._on_key)
        self.add_controller(key)

        self.refresh_installed()

    # ── 事件 ──────────────────────────────────
    def _on_key(self, _c, keyval, _code, state):
        if keyval in (Gdk.KEY_o,) and state & Gdk.ModifierType.CONTROL_MASK:
            self.pick_file()
            return True
        return False

    def _on_drop(self, _t, value, _x, _y):
        files = value.get_files() if hasattr(value, "get_files") else []
        for f in files:
            p = f.get_path()
            if p and pkg_format(p):
                self.load_file(p)
                return True
        self.toast.add_toast(Adw.Toast.new("只认 .deb / .rpm / .AppImage / .flatpak 文件"))
        return False

    def pick_file(self):
        dlg = Gtk.FileDialog()
        dlg.set_title("选择安装包")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        f = Gtk.FileFilter()
        f.set_name("安装包 (*.deb, *.rpm, *.AppImage, *.flatpak)")
        for pat in ("*.deb", "*.rpm", "*.AppImage", "*.appimage", "*.flatpak", "*.flatpakref"):
            f.add_pattern(pat)
        filters.append(f)
        # 逐个格式也给一条，方便只想看某一种的时候筛
        for ext, label in (
            (".deb", "Debian 包 (*.deb)"),
            (".rpm", "RPM 包 (*.rpm)"),
            (".AppImage", "AppImage (*.AppImage)"),
            (".flatpak", "Flatpak 单文件包 (*.flatpak)"),
        ):
            one = Gtk.FileFilter()
            one.set_name(label)
            one.add_pattern(f"*{ext}")
            filters.append(one)
        dlg.set_filters(filters)
        dlg.set_default_filter(f)
        try:
            dlg.open(self, None, self._picked)
        except Exception:
            pass

    def _picked(self, dlg, result):
        try:
            f = dlg.open_finish(result)
        except GLib.Error:
            return
        if f:
            self.load_file(f.get_path())

    # ── 页 1 构建 ──────────────────────────────
    def _build_install_page(self):
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_vexpand(True)

        self.clamp = Adw.Clamp()
        self.clamp.set_maximum_size(760)
        self.clamp.set_margin_top(18)
        self.clamp.set_margin_bottom(24)
        self.clamp.set_margin_start(12)
        self.clamp.set_margin_end(12)

        self.install_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.clamp.set_child(self.install_box)
        self.scroll.set_child(self.clamp)
        self.stack_page_install = self.scroll

        self._show_empty_state()
        return self.scroll

    def _clear_install_box(self):
        child = self.install_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.install_box.remove(child)
            child = nxt

    def _show_empty_state(self):
        self._clear_install_box()
        dz = DropZone()
        dz.btn.connect("clicked", lambda *_: self.pick_file())
        self.install_box.append(dz)
        self.current_meta = None

    # ── 载入一个包 ──────────────────────────────
    def load_file(self, path: str):
        meta = read_pkg_meta(path)
        if not meta.get("_valid"):
            fmt = pkg_format(path)
            self.toast.add_toast(
                Adw.Toast.new(f"这不像一个合法的 .{fmt} 包" if fmt else "不认识的包格式")
            )
            return
        self.current_meta = meta
        self._render_package(meta)

        # 后台跑 pkg2local --json 拿 Arch 生态对照和缺依赖
        self._spawn(
            [BACKEND, path, "--json"],
            self._on_deps_json,
        )

    def _render_package(self, meta: dict):
        self._clear_install_box()

        # ── 文件卡 ──
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        head.add_css_class("card")
        head.set_margin_top(0)

        ic = Gtk.Image.new_from_icon_name("package-x-generic-symbolic")
        ic.set_pixel_size(48)
        ic.add_css_class("dim-label")
        head.append(ic)

        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        txt.set_hexpand(True)
        name = Gtk.Label(label=meta.get("Package", "?"))
        name.add_css_class("title-2")
        name.set_xalign(0)
        name.set_ellipsize(3)
        txt.append(name)

        sub = Gtk.Label(
            label=f"版本 {meta.get('Version','?')}  ·  {meta.get('Architecture','?')}"
                  f"  ·  {(meta.get('_format') or '?').upper()}"
                  f"  ·  {human_size(meta.get('_size', 0))}"
        )
        sub.add_css_class("dim-label")
        sub.set_xalign(0)
        txt.append(sub)

        fn = Gtk.Label(label=os.path.basename(meta.get("_file", "")))
        fn.add_css_class("caption")
        fn.add_css_class("dim-label")
        fn.set_xalign(0)
        fn.set_ellipsize(3)
        txt.append(fn)
        head.append(txt)

        btn_clear = Gtk.Button(icon_name="window-close-symbolic")
        btn_clear.add_css_class("flat")
        btn_clear.set_valign(Gtk.Align.CENTER)
        btn_clear.set_tooltip_text("换个文件")
        btn_clear.connect("clicked", lambda *_: self._show_empty_state())
        head.append(btn_clear)

        wrap = Gtk.Box()
        wrap.add_css_class("card")
        wrap.append(head)
        self.install_box.append(wrap)

        # ── 结论区（先占位，等 JSON 回来填） ──
        self.result_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.install_box.append(self.result_box)

        self.spinner_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        sp = Gtk.Spinner()
        sp.start()
        self.spinner_row.append(sp)
        lbl = Gtk.Label(label="正在检查 Arch 生态和依赖…")
        lbl.add_css_class("dim-label")
        self.spinner_row.append(lbl)
        self.result_box.append(self.spinner_row)

        # ── 依赖清单 ──
        dep = meta.get("Depends", "")
        if dep:
            exp = Adw.ExpanderRow()
            # flatpak 那一栏放的其实是 runtime（org.gnome.Platform/x86_64/50），不是依赖
            exp.set_title("依赖的运行时" if meta.get("_format") == "flatpak" else "声明的依赖")
            n = len([d for d in dep.split(",") if d.strip()])
            exp.set_subtitle(f"{n} 项")
            for d in dep.split(","):
                d = re.sub(r"\(.*?\)", "", d).strip()
                if not d:
                    continue
                r = Adw.ActionRow()
                r.set_title(d)
                r.add_css_class("property")
                exp.add_row(r)
            box = Gtk.ListBox()
            box.add_css_class("boxed-list")
            box.set_selection_mode(Gtk.SelectionMode.NONE)
            box.append(exp)
            self.install_box.append(box)

        self.install_btn = Gtk.Button(
            label="交给 flatpak 安装" if meta.get("_format") == "flatpak" else "安装到 ~/.local"
        )
        self.install_btn.add_css_class("suggested-action")
        self.install_btn.add_css_class("pill")
        self.install_btn.set_halign(Gtk.Align.CENTER)
        self.install_btn.set_size_request(220, -1)
        self.install_btn.connect("clicked", lambda *_: self.do_install())
        self.install_box.append(self.install_btn)

    def _on_deps_json(self, code: int, out: str, err: str):
        if self.install_box.get_first_child() is None:
            return
        if hasattr(self, "spinner_row") and self.spinner_row.get_parent():
            self.result_box.remove(self.spinner_row)
        try:
            data = json.loads(out.strip().splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            self._add_banner("检查失败", "无法解析 pkg2local 的输出", C_RED)
            return
        alt = data.get("arch_equivalent") or ""
        missing = data.get("missing_deps") or []
        unknown = data.get("unknown_deps") or []
        fmt = (data.get("format") or "").lower()

        if alt:
            kind = "AUR" if alt.startswith("aur/") else "仓库"
            self._add_banner(
                f"{kind} 已经有现成的包",
                f"{alt}  ——  直接  paru -S {alt.split('/')[-1]}  更省事，"
                f"跟着系统一起升级，不用担心依赖漂移。",
                C_YEL,
            )
            if self.install_btn:
                self.install_btn.remove_css_class("suggested-action")
                self.install_btn.add_css_class("pill")
                self.install_btn.set_label("仍要安装这个包（不推荐）")
            copy = Gtk.Button(label=f"复制  paru -S {alt.split('/')[-1]}")
            copy.add_css_class("pill")
            copy.add_css_class("suggested-action")
            copy.set_halign(Gtk.Align.CENTER)
            copy.connect("clicked", lambda *_: self._copy(f"paru -S {alt.split('/')[-1]}"))
            self.result_box.append(copy)

        # AppImage / flatpak 不参与依赖检查：前者自带 runtime，
        # 后者用 flatpak 自己的 runtime。不说清楚的话绿色「依赖齐全」会误导，
        # 因为它们根本没声明依赖，不是声明了且都满足。
        if fmt == "appimage":
            self._add_banner(
                "自带运行时",
                "AppImage 把依赖和运行时都打包在文件里，不需要在系统里找库。"
                "安装只是把它抄进 ~/.local/opt 并登记图标和菜单项。",
                C_GRN,
            )
        elif fmt == "flatpak":
            self._add_banner(
                "依赖由运行时提供",
                "flatpak 应用跑在自己的沙箱运行时里，不依赖系统的库。"
                "安装会交给 flatpak install --user，runtime 缺的话它会自动去 Flathub 拉。",
                C_GRN,
            )
        elif missing:
            self._add_banner(
                f"缺 {len(missing)} 个依赖",
                "先补依赖再装，否则装完可能跑不起来：\n"
                + "sudo pacman -S --needed " + " ".join(missing),
                C_RED,
            )
            copy = Gtk.Button(label="复制 pacman 命令")
            copy.add_css_class("pill")
            copy.connect(
                "clicked",
                lambda *_: self._copy("sudo pacman -S --needed " + " ".join(missing)),
            )
            self.result_box.append(copy)
        elif unknown:
            self._add_banner(
                f"{len(unknown)} 项依赖没收录映射",
                "这些依赖名没有收录映射，装完可能缺库：\n"
                + ", ".join(unknown)
                + "\n\n不确定的话，装完点「已安装」页的 ▶ 试跑一次，"
                  "再用 ldd 查缺什么。",
                C_YEL,
            )
        else:
            self._add_banner(
                "依赖齐全",
                "声明的依赖在系统里都找得到，可以直接装。",
                C_GRN,
            )

    def _add_banner(self, title: str, body: str, color: str):
        f = Adw.PreferencesGroup()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        dot = Gtk.DrawingArea()
        dot.set_content_width(8)
        dot.set_content_height(8)
        rgb = tuple(int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))

        def _draw(_area, cr, w, h, *_rest):
            cr.set_source_rgb(*rgb)
            cr.arc(w / 2, h / 2, min(w, h) / 2 - 1, 0, 6.2832)
            cr.fill()

        dot.set_draw_func(_draw)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_margin_top(4)
        row.append(dot)
        lbl = Gtk.Label()
        lbl.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        lbl.set_xalign(0)
        row.append(lbl)
        box.append(row)

        b = Gtk.Label(label=body)
        b.set_wrap(True)
        b.set_xalign(0)
        b.set_selectable(True)
        b.add_css_class("dim-label")
        b.set_margin_start(16)
        box.append(b)

        holder = Gtk.Box()
        holder.add_css_class("card")
        holder.append(box)
        self.result_box.append(holder)

    # ── 执行安装 ────────────────────────────────
    def do_install(self):
        if not self.current_meta or self.busy:
            return
        self.busy = True
        self.install_btn.set_sensitive(False)
        self.install_btn.set_label("安装中…")

        path = self.current_meta["_file"]
        self._spawn([BACKEND, path, "-y"], self._on_install_done, capture_all=True)

    def _on_install_done(self, code: int, out: str, err: str):
        self.busy = False
        if hasattr(self, "install_btn"):
            self.install_btn.set_sensitive(True)
        log = (out + err).strip()
        if code == 0:
            self.toast.add_toast(Adw.Toast.new("装好了"))
            self.refresh_installed()
            self._show_log("安装成功", log, C_GRN)
            self.stack.set_visible_child_name("installed")
        else:
            self.toast.add_toast(Adw.Toast.new("安装失败"))
            self._show_log("安装失败", log, C_RED)

    def _show_log(self, title: str, log: str, color: str):
        # 把进度日志塞进一个可折叠区域
        if hasattr(self, "log_expander") and self.log_expander.get_parent():
            self.log_expander.get_parent().remove(self.log_expander)
        exp = Adw.ExpanderRow()
        exp.set_title(title)
        exp.set_subtitle("展开看完整日志")
        exp.set_expanded(True)
        tv = Gtk.TextView()
        tv.set_editable(False)
        tv.set_monospace(True)
        buf = tv.get_buffer()
        buf.set_text(log)
        sw = Gtk.ScrolledWindow()
        sw.set_child(tv)
        sw.set_min_content_height(200)
        row = Adw.ActionRow()
        row.set_child(sw)
        exp.add_row(row)
        box = Gtk.ListBox()
        box.add_css_class("boxed-list")
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.append(exp)
        if hasattr(self, "result_box"):
            self.result_box.append(box)
        self.log_expander = exp

    def _copy(self, text: str):
        cb = Gdk.Display.get_default().get_clipboard()
        cb.set(text)
        self.toast.add_toast(Adw.Toast.new("已复制"))

    # ── 页 2：已安装 ────────────────────────────
    def _build_installed_page(self):
        self.inst_scroll = Gtk.ScrolledWindow()
        self.inst_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.inst_clamp = Adw.Clamp()
        self.inst_clamp.set_maximum_size(760)
        self.inst_clamp.set_margin_top(18)
        self.inst_clamp.set_margin_bottom(24)
        self.inst_clamp.set_margin_start(12)
        self.inst_clamp.set_margin_end(12)
        self.inst_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.inst_clamp.set_child(self.inst_box)
        self.inst_scroll.set_child(self.inst_clamp)
        return self.inst_scroll

    def refresh_installed(self):
        child = self.inst_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.inst_box.remove(child)
            child = nxt

        items = list_installed()
        if not items:
            sp = Adw.StatusPage()
            sp.set_icon_name("package-x-generic-symbolic")
            sp.set_title("还没装过包")
            sp.set_description("装过的包会出现在这里，每个都能一键卸载。")
            self.inst_box.append(sp)
            return

        group = Adw.PreferencesGroup()
        group.set_title(f"通过 pkg2local 装的应用（{len(items)}）")
        group.set_description("这些都在 ~/.local 下，不占 pacman 数据库")

        for m in items:
            row = Adw.ActionRow()
            row.set_title(m.get("package", "?"))
            sub = f"{m.get('version','?')}  ·  {m.get('installed_at','')[:10]}"
            exes = m.get("executables") or []
            if exes:
                sub += "  ·  " + ", ".join(exes[:3])
            row.set_subtitle(sub)

            run = Gtk.Button(icon_name="media-playback-start-symbolic")
            run.add_css_class("flat")
            run.set_valign(Gtk.Align.CENTER)
            run.set_tooltip_text("启动")
            if exes:
                run.connect("clicked", lambda _b, e=exes[0]: self._launch(e))
            else:
                run.set_sensitive(False)
            row.add_suffix(run)

            rm = Gtk.Button(icon_name="user-trash-symbolic")
            rm.add_css_class("flat")
            rm.set_valign(Gtk.Align.CENTER)
            rm.set_tooltip_text("卸载")
            rm.connect("clicked", lambda _b, pkg=m.get("package"): self._confirm_uninstall(pkg))
            row.add_suffix(rm)

            group.add(row)

        box = Gtk.ListBox()
        box.add_css_class("boxed-list")
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.append(group)
        self.inst_box.append(box)

    def _launch(self, exe: str):
        p = shutil.which(exe) or str(BIN_DIR / exe)
        # flatpak 的应用不在 PATH 上（exports/bin 只有 system 域那条在 PATH 里），
        # 所以还要试一下用户域的导出目录
        if not os.path.exists(p):
            fp = Path.home() / ".local/share/flatpak/exports/bin" / exe
            if fp.exists():
                p = str(fp)
        try:
            subprocess.Popen(
                [p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.toast.add_toast(Adw.Toast.new(f"启动了 {exe}"))
        except OSError as e:
            self.toast.add_toast(Adw.Toast.new(f"启动失败：{e}"))

    def _confirm_uninstall(self, pkg: str):
        d = Adw.AlertDialog()
        d.set_heading(f"卸载 {pkg}？")
        d.set_body("会删掉 ~/.local/opt 下的目录、命令软链和桌面图标。")
        d.add_response("cancel", "取消")
        d.add_response("ok", "卸载")
        d.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response("cancel")
        d.set_close_response("cancel")

        def on_resp(_d, resp):
            if resp != "ok":
                return
            r = subprocess.run(
                [BACKEND, "--uninstall", pkg],
                capture_output=True, text=True, timeout=60,
            )
            if r.returncode == 0:
                self.toast.add_toast(Adw.Toast.new(f"{pkg} 已卸载"))
            else:
                self.toast.add_toast(Adw.Toast.new("卸载失败：" + r.stderr.strip()[:80]))
            self.refresh_installed()

        d.connect("response", on_resp)
        d.present(self)

    # ── 子进程封装 ──────────────────────────────
    def _spawn(self, argv: list[str], cb, capture_all=False):
        def work():
            try:
                r = subprocess.run(argv, capture_output=True, text=True, timeout=300)
                code, out, err = r.returncode, r.stdout, r.stderr
            except subprocess.TimeoutExpired:
                code, out, err = 124, "", "超时"
            except FileNotFoundError:
                code, out, err = 127, "", f"找不到 {argv[0]}"
            GLib.idle_add(lambda: (cb(code, out, err), False)[1])

        threading.Thread(target=work, daemon=True).start()


# ─────────────────────────── 启动 ───────────────────────────
CSS = f"""
.drop-target {{ border: 2px dashed alpha(currentColor, 0.25); border-radius: 12px; }}
"""


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=0)
        self.connect("activate", self.on_activate)

    def _grab(self, w, path):
        """把窗口内容直接渲成 PNG（自测/文档用）"""
        import cairo
        from gi.repository import Graphene, Gsk

        width, height = w.get_width(), w.get_height()
        p = Gtk.WidgetPaintable.new(w)
        snap = Gtk.Snapshot()
        p.snapshot(snap, width, height)
        node = snap.to_node()
        r = Gsk.CairoRenderer.new()
        r.realize_for_display(w.get_display())
        tex = r.render_texture(node, Graphene.Rect().init(0, 0, width, height))
        if tex:
            tex.save_to_png(path)
            print(f"[shot] {path} {width}x{height}", file=sys.stderr)
        os._exit(0)   # 跳过 renderer dispose 的 assert

    def on_activate(self, *_):
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        w = Window(self)
        w.present()
        shot_path = os.environ.get("PKG_INSTALLER_SHOT") or os.environ.get("DEB_INSTALLER_SHOT")
        # 命令行带文件路径则直接载入（必须在装定时器之前，autoinstall 才能看到）
        for a in sys.argv[1:]:
            if pkg_format(a) and os.path.isfile(a):
                w.load_file(a)
                break

        tab = os.environ.get("PKG_INSTALLER_TAB") or os.environ.get("DEB_INSTALLER_TAB")
        if tab:
            GLib.timeout_add(1200, lambda: (w.stack.set_visible_child_name(tab), False)[1])
        auto = os.environ.get("PKG_INSTALLER_AUTOINSTALL") or os.environ.get("DEB_INSTALLER_AUTOINSTALL")
        if auto and w.current_meta:
            GLib.timeout_add(6000, lambda: (w.do_install(), False)[1])
        if shot_path:
            delay = int(
                os.environ.get("PKG_INSTALLER_SHOT_DELAY")
                or os.environ.get("DEB_INSTALLER_SHOT_DELAY", "2200")
            )
            GLib.timeout_add(delay, lambda: (self._grab(w, shot_path), False)[1])


def main():
    if "--version" in sys.argv or "-V" in sys.argv:
        print(f"pkg-installer {VERSION}")
        return 0
    if not os.path.isfile(BACKEND) or not os.access(BACKEND, os.X_OK):
        print(
            f"找不到后端 pkg2local（应在 {BACKEND}）。\n"
            "后端随仓库一起发布，重新跑一次 install.sh 即可：\n"
            "  curl -fsSL https://raw.githubusercontent.com/Aceared0829/pkg-installer/main/install.sh | bash",
            file=sys.stderr,
        )
        return 1
    app = App()
    # 只把 argv[0] 交给 Gtk.Application，文件路径自己处理，
    # 否则会触发 "This application can not open files"
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
